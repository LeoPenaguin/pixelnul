# Copy to .env (ignored by Git) and fill in. Real environment variables take precedence.
# Google sign-in: https://console.cloud.google.com → Google Auth Platform → Clients.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Discord sign-in: https://discord.com/developers/applications → OAuth2 (Client ID, Client Secret, Redirects).
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# PUBLIC_URL=http://localhost:5173
# PIXEL_REFILL_MS=1000
# Moderators: user ids separated by commas (sign in, then read your id at /api/me).
# ADMIN_IDS=
